# Template for a SEPARATE disposable staging deployment. No real secrets here.
# Copy to backend/.env on Ubuntu; chmod 600 .env. Do not source as shell code.
APP_ENV=qa
DATABASE_URL=postgresql+psycopg://rrhh_staging:REPLACE@db-staging:5432/rrhh_staging
JWT_ACCESS_SECRET=
JWT_ISSUER=correspondencia-api
JWT_AUDIENCE=correspondencia-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
API_PREFIX=
COOKIE_NAME=refresh_token
# Apache strips /api from requests. Browser cookie path must include /api.
COOKIE_PATH=/api/auth
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Same-origin HTTPS frontend + /api reverse proxy needs no CORS.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
STORAGE_ROOT=storage-staging

BIOMETRIC_IP=
BIOMETRIC_PORT=4370
BIOMETRIC_PASSWORD=
BIOMETRIC_TIMEOUT=30
BIOMETRIC_TRANSPORT=auto
BIOMETRIC_ENCODING=UTF-8
BIOMETRIC_DEVICE_ID=
BIOMETRIC_MATCH_DOCUMENT_NUMBER=false
# Enables only the temporary source; APP_ENV must be qa and DB name must match.
RRHH_STAGING_CONFIG=/etc/rrhh-staging/attendance.json
# Worker uses the SAME .env / DB / device as API; queue polling is fixed at 5s.
# BIOMETRIC_POLL_INTERVAL belongs to original reader monitor, not this worker.
