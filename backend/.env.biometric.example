# Merge into backend/.env or supply process environment. Never commit actual keys.
#
# The RRHH backend consumes the biometric API published over HTTPS.
# It no longer opens TCP connections to the clock: pyzk stays only as a
# retired reference in app/modules/rrhh/reader/.
BIOMETRIC_API_URL=https://biometric.sipesipe.gob.bo
# Token Bearer of the biometric API. Generate it on the server; never commit it.
BIOMETRIC_API_TOKEN=
# Timeout of a single HTTPS call, in seconds. A full-history page can be slow.
BIOMETRIC_API_TIMEOUT=60
# Must match the device_id reported by the API, otherwise record_id would differ
# and the same marking would be stored twice.
BIOMETRIC_DEVICE_ID=alcaldia-central
# Enable ONLY after confirming that device user_id equals employees.document_number.
BIOMETRIC_MATCH_DOCUMENT_NUMBER=false

# Retired from the execution path (direct device source via pyzk):
# BIOMETRIC_IP=
# BIOMETRIC_PORT=4370
# BIOMETRIC_PASSWORD=
# BIOMETRIC_TRANSPORT=auto
# BIOMETRIC_ENCODING=UTF-8
