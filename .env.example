# PostgreSQL - desarrollo local
POSTGRES_DB=correspondencia_sipe
POSTGRES_USER=sipe_app
POSTGRES_PASSWORD=sipe_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://sipe_app:sipe_dev_password@postgres:5432/correspondencia_sipe

# CORS (dev): origins explicitos (nunca wildcard cuando allow_credentials=true)
CORS_ALLOW_ORIGINS=http://localhost:5000
CORS_ALLOW_CREDENTIALS=true

# Auth
# JWT_ACCESS_SECRET must be at least 32 characters (HS256 requirement).
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The real value lives in .env (gitignored) or the deployment secret manager.
JWT_ACCESS_SECRET=
JWT_ISSUER=correspondencia-api
JWT_AUDIENCE=correspondencia-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies (dev)
COOKIE_NAME=refresh_token
COOKIE_PATH=/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
