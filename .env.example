# PostgreSQL - desarrollo local
POSTGRES_DB=correspondencia_sipe
POSTGRES_USER=sipe_app
POSTGRES_PASSWORD=sipe_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://sipe_app:sipe_dev_password@postgres:5432/correspondencia_sipe

# development: localhost/127.0.0.1 en cualquier puerto, exclusivamente.
# qa/production: Flutter usa /api, mismo origen mediante Apache.
APP_ENV=development

# Compatibilidad externa SOLO QA/production (vacío por defecto).
# No agregar la IP externa del servidor. No usar wildcard con credentials.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

# Auth
# JWT_ACCESS_SECRET must be at least 32 characters (HS256 requirement).
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The real value lives in .env (gitignored) or the deployment secret manager.
JWT_ACCESS_SECRET=
JWT_ISSUER=correspondencia-api
JWT_AUDIENCE=correspondencia-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies (dev)
COOKIE_NAME=refresh_token
COOKIE_PATH=/auth
# Vacío: false en development/qa HTTP; true en production HTTPS.
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# Storage (archivos en disco: adjuntos, PDFs generados, plantillas)
# Clave relativa bajo este directorio; nunca rutas absolutas en DB.
# Docker: usar /app/storage y montar volumen persistente (ver docker-compose.yml).
STORAGE_ROOT=storage
# Logo institucional para PDF de encadenamiento (opcional).
# Si no existe o está vacío, el PDF se genera con placeholder.
# INSTITUTIONAL_LOGO_PATH=assets/logo_gam_sipe_sipe.png

# Adjuntos de correspondencia
MAX_ATTACHMENT_SIZE_MB=25
# Lista separada por comas (MIME types permitidos)
# ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
