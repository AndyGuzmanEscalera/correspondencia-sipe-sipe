{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Correspondencia (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-hostname=localhost",
        "--web-port=5000",
        "--dart-define=API_BASE_URL=http://localhost:8000"
      ]
    },
    {
      "name": "Correspondencia (Chrome release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release",
      "args": [
        "--web-hostname=localhost",
        "--web-port=5000",
        "--dart-define=API_BASE_URL=http://localhost:8000"
      ]
    }
  ]
}
